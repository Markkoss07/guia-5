#include <iostream>
using namespace std;

int main()
{
    int numeros[10];
    int menorImpar;
    int mayorPar;
    bool primeroImpar = true;
    bool primeroPar = true;

    for(int i = 0; i < 10; i++)
    {
        cout << "Ingrese un numero: ";
        cin >> numeros[i];
    }

    for(int i = 0; i < 10; i++)
    {
        if(numeros[i] % 2 != 0)
        {
            if(primeroImpar == true)
            {
                menorImpar = numeros[i];
                primeroImpar = false;
            }
            else if(numeros[i] < menorImpar)
            {
                menorImpar = numeros[i];
            }
        }
        else
        {
            if(primeroPar == true)
            {
                mayorPar = numeros[i];
                primeroPar = false;
            }
            else if(numeros[i] > mayorPar)
            {
                mayorPar = numeros[i];
            }
        }
    }

    cout << "El menor de los impares es: " << menorImpar << endl;
    cout << "El mayor de los pares es: " << mayorPar;

    return 0;
}
