#include <iostream>
using namespace std;

int main()
{
    int numeros[10];
    int suma = 0;
    float promedio;

    for(int i = 0; i < 10; i++)
    {
        cout << "Ingrese un numero: ";
        cin >> numeros[i];

        suma = suma + numeros[i];
    }

    promedio = suma / 10.0;

    cout << "\nEl promedio es: " << promedio << endl;

    cout << "Numeros mayores al promedio: " << endl;

    for(int i = 0; i < 10; i++)
    {
        if(numeros[i] > promedio)
        {
            cout << numeros[i] << endl;
        }
    }

    return 0;
}
