
#include <iostream>
using namespace std;

int main()
{
    int numeros[10];
    int suma = 0;

    for(int i = 0; i < 10; i++)
    {
        cout << "Ingrese un numero: ";
        cin >> numeros[i];

        suma = suma + numeros[i];
    }

    cout << "La suma de los valores es: " << suma;

    return 0;
}
